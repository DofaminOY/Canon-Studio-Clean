# Copy to .env if you use a process manager that loads .env.
# Canon Studio does not load .env automatically: set variables in PowerShell.
CANON_IP=192.168.1.100
CANON_STUDIO_PORT=3177
# POPPLER_BIN=C:\path\to\poppler\Library\bin
# SUMATRA_PDF_PATH=C:\path\to\SumatraPDF.exe

# Для подключения сайта на Vercel к локальному агенту нужен точный HTTPS origin.
# Указывать только домен своего сайта, без / в конце. Подстановочные знаки запрещены.
# CANON_STUDIO_ALLOWED_ORIGIN=https://canon-studio-clean.vercel.app
