*.pdf.tmp
*.part
*.bak
backup*/
_backups/
*.zip
*.7z
*.rar
diagnostics/
.tmp/
temp/
uploads/
printouts/

# Never commit original personal documents/photos
*.local.pdf
*.local.jpg
*.local.png

# Build-time browser copies of pdfjs (regenerated by npm run build:web)
public/vendor/
