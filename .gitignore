# Dependency installation is always local
node_modules/

# Secrets and machine-specific settings
.env
.env.*
!.env.example

# Build, coverage, editor and OS state
coverage/
dist/
build/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

